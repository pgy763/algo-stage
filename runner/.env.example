# 复制成 .env 再填你自己的 key（.env 已在 .gitignore 里，不会被提交）
#
# 任何 OpenAI 兼容接口都能用，比如：
#   阿里云百炼 / MaaS   https://xxx.maas.aliyuncs.com/compatible-mode/v1
#   DeepSeek           https://api.deepseek.com/v1
#   智谱               https://open.bigmodel.cn/api/paas/v4
#   Ollama（本地）      http://localhost:11434/v1

LLM_MODEL_ID=glm-5.3
LLM_API_KEY=
LLM_BASE_URL=https://xxx.maas.aliyuncs.com/compatible-mode/v1

# ============ 执行服务（可选，一般不用改） ============
#
# 这个接口会在本机编译并执行代码，所以默认只监听 127.0.0.1，并且只认下面这些前端来源。
# 把 runner 部署到服务器、让线上静态站调用时，才需要改这几项。

# PORT=5199
# 监听地址。改 0.0.0.0 就等于把「任意代码执行」开放给整个网络，想清楚再改
# HOST=127.0.0.1

# 允许调用本服务的页面来源（逗号分隔，含协议和端口）
# ALLOW_ORIGINS=https://pgy763.github.io,http://localhost:5175

# 部署到远程时，除了来源还要放行自己的域名（防 DNS rebinding）
# ALLOW_HOSTS=runner.example.com

# 同时最多跑几个编译/执行
# MAX_CONCURRENT=4
